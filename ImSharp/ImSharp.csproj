<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Platforms>x64</Platforms>
        <PlatformTarget>x64</PlatformTarget>
        <Configurations>Debug;Release</Configurations>
        <LangVersion>preview</LangVersion>
        <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Deterministic>true</Deterministic>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

        <FileVersion>1.0.0.0</FileVersion>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>

        <!--<DefineConstants>STATECHECKS;$(DefineConstants)</DefineConstants>-->
        <DefineConstants>IMPLOT;$(DefineConstants)</DefineConstants>
        <!--<DefineConstants>IMNODES;$(DefineConstants)</DefineConstants>-->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2024.2.0" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0" />
        <PackageReference Include="System.IO.Hashing" Version="9.0" />
    </ItemGroup>

    <ItemGroup>
        <None Update="lib/cimgui.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>cimgui.dll</TargetPath>
        </None>
        <None Update="lib/cimnodes.dll" Condition="$(DefineConstants.Contains(IMNODES))">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>cimnodes.dll</TargetPath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="Resources\include\*.hlsli" />
        <None Include="Resources\*.hlsl" />
        <None Include="Build-Shaders.ps1" />
        <EmbeddedResource Include="Resources\*.dxbc" Condition="$(DefineConstants.Contains(HAS_TERRAFX))" />
    </ItemGroup>
</Project>
